---
import HtmlLayout from "../../layouts/HtmlLayout.astro";
import { G } from "../../lib/globals.js";
import { getPublicNotesPosts } from "../../lib/notes.js";

const posts = await getPublicNotesPosts();
---

<HtmlLayout title={`Notes ~ ${G.BlogTitle}`} sectionTitle="Notes">
    <main
        class="mx-auto flex max-w-4xl flex-col gap-4 px-3 py-12 text-lg lg:px-0"
    >
        <article class="flex flex-col gap-4">
            <ul class="list-none p-0">
                {
                    posts.map((post) => (
                        <li>
                            <a
                                class="text-link3 hover:bg-link3 hover:px-2 hover:text-background"
                                href={`/notes/${post.slug}`}
                            >
                                {post.title}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </article>
    </main>
</HtmlLayout>
