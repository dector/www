---
import "../styles/global.css";
import { G } from "../lib/globals.js";

interface Props {
    title: string;
    sectionTitle?: string;
    bodyClass?: string;
    lang?: string;
    viewport?: string;
}

const {
    title,
    sectionTitle,
    bodyClass,
    lang = "en",
    viewport = "width=device-width, initial-scale=1",
} = Astro.props;

const hasSectionTitleRow = sectionTitle !== undefined;
const normalizedSectionTitle = sectionTitle?.trim();
---

<html lang={lang} class="min-h-full">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content={viewport} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Noto+Sans+Mono:wght@100..900&display=swap"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
    </head>

    <body
        class:list={[
            "min-h-full bg-background font-sans leading-6 text-normal",
            bodyClass,
        ]}
    >
        <header class="fixed inset-x-0 top-0 z-10">
            <div class="mx-auto max-w-4xl px-3 py-3 lg:px-0">
                <div class="flex items-center justify-between">
                    <a
                        href="/"
                        class="inline-block font-mono text-sm text-normal-lighter no-underline hover:text-link3"
                    >
                        {G.BlogTitle}
                    </a>
                    <a
                        href="https://github.com/dector"
                        class="inline-block font-mono text-sm text-normal-lighter no-underline hover:text-link3"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        github
                    </a>
                </div>
                {
                    hasSectionTitleRow && (
                        <div class="mt-1 h-7 font-mono text-xl font-light text-normal-lighter opacity-80">
                            {normalizedSectionTitle ? `/${normalizedSectionTitle}/` : ""}
                        </div>
                    )
                }
            </div>
        </header>
        <div class:list={["pt-10", hasSectionTitleRow && "pt-20"]}>
            <slot />
        </div>
    </body>
</html>
