---
import "../styles/global.css";
import { G } from "../lib/globals.ts";
import { buildMeta } from "../lib/build-meta.ts";

interface Props {
    title: string;
    description?: string;
    sectionTitle?: string;
    sectionHref?: string;
    bodyClass?: string;
    lang?: string;
    viewport?: string;
    canonical?: string;
    robots?: string;
    socialImage?: string;
    ogType?: "website" | "article";
    publishedTime?: string;
    modifiedTime?: string | null;
    articleTags?: string[];
}

const {
    title,
    description = G.BlogDescription,
    sectionTitle,
    sectionHref,
    bodyClass,
    lang = "en",
    viewport = "width=device-width, initial-scale=1",
    canonical,
    robots = "index,follow",
    socialImage = "/social-card.svg",
    ogType = "website",
    publishedTime,
    modifiedTime,
    articleTags = [],
} = Astro.props;

const hasSectionTitleRow = sectionTitle !== undefined;
const normalizedSectionTitle = sectionTitle?.trim();
const site = Astro.site ?? Astro.url;
const canonicalUrl = canonical
    ? new URL(canonical, site).href
    : new URL(Astro.url.pathname, site).href;
const socialImageUrl = new URL(socialImage, site).href;
const rssUrl = new URL("/rss.xml", site).href;
const currentPath = Astro.url.pathname;
const isNotesSection = currentPath === "/notes" || currentPath.startsWith("/notes/");
const isProjectsSection =
    currentPath === "/projects" || currentPath.startsWith("/projects/");
const commitUrlTemplate = G.CommitUrlTemplate ?? "";
const buildCommitUrl = commitUrlTemplate.replace(
    "{{COMMIT}}",
    encodeURIComponent(buildMeta.fullHash),
);
---

<html lang={lang} class="min-h-full">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content={viewport} />
        <meta name="description" content={description} />
        <meta name="robots" content={robots} />
        <link rel="canonical" href={canonicalUrl} />

        <meta property="og:site_name" content={G.BlogTitle} />
        <meta property="og:locale" content="en_US" />
        <meta property="og:type" content={ogType} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={socialImageUrl} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageUrl} />

        {
            ogType === "article" && publishedTime && (
                <meta property="article:published_time" content={publishedTime} />
            )
        }
        {
            ogType === "article" && modifiedTime && (
                <meta property="article:modified_time" content={modifiedTime} />
            )
        }
        {
            ogType === "article" &&
                articleTags.map((tag) => (
                    <meta property="article:tag" content={tag} />
                ))
        }

        <link rel="alternate" type="application/rss+xml" title={`${G.BlogTitle} RSS`} href={rssUrl} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Noto+Sans+Mono:wght@100..900&display=swap"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
    </head>

    <body
        class:list={[
            "min-h-screen bg-background font-sans leading-6 text-normal",
            "flex flex-col",
            bodyClass,
        ]}
    >
        <header class="fixed inset-x-0 top-0 z-10 bg-background">
            <div class="mx-auto max-w-4xl px-3 py-3 lg:px-0">
                <div class="flex items-center justify-between gap-4">
                    <a
                        href="/"
                        class="inline-block font-mono text-sm text-normal-lighter no-underline hover:text-link3"
                    >
                        {G.BlogTitle}
                    </a>
                    <div class="flex items-center gap-4">
                        <div class="flex items-center gap-3 border-r border-muted/70 pr-4">
                            <a
                                href="/notes"
                                class:list={[
                                    "inline-block font-mono text-sm no-underline",
                                    isNotesSection
                                        ? "text-white font-bold"
                                        : "text-normal-lighter hover:text-normal-lighter3",
                                ]}
                            >
                                /notes
                            </a>
                            <a
                                href="/projects"
                                class:list={[
                                    "inline-block font-mono text-sm no-underline",
                                    isProjectsSection
                                        ? "text-white font-bold"
                                        : "text-normal-lighter hover:text-normal-lighter3",
                                ]}
                            >
                                /projects
                            </a>
                        </div>
                        <div class="flex items-center gap-4">
                            <a
                                href="https://github.com/dector"
                                class="inline-block font-mono text-sm text-normal-lighter no-underline hover:text-link3"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                github
                            </a>
                            <a
                                href="https://mastodon.online/@dector"
                                class="inline-block font-mono text-sm text-normal-lighter no-underline hover:text-link3"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                mastodon
                            </a>
                            <a
                                href="/rss.xml"
                                class="inline-block font-mono text-sm text-normal-lighter no-underline hover:text-link3"
                            >
                                rss
                            </a>
                        </div>
                    </div>
                </div>
                {
                    hasSectionTitleRow && (
                        <div
                            class:list={[
                                "mt-1 h-7 font-mono text-xl font-light opacity-90",
                                isProjectsSection ? "text-link2" : "text-link3",
                            ]}
                        >
                            {normalizedSectionTitle ? (
                                sectionHref ? (
                                    <a
                                        href={sectionHref}
                                        class:list={[
                                            "no-underline",
                                            isProjectsSection
                                                ? "hover:text-link1"
                                                : "hover:text-link3",
                                        ]}
                                    >
                                        {`/${normalizedSectionTitle}/`}
                                    </a>
                                ) : (
                                    `/${normalizedSectionTitle}/`
                                )
                            ) : ""}
                        </div>
                    )
                }
            </div>
        </header>
        <div class:list={["pt-10", hasSectionTitleRow && "pt-20", "flex-1"]}>
            <slot />
        </div>

        <footer class="mx-auto w-full max-w-4xl px-3 py-3 text-center lg:px-0">
            <a
                href={buildCommitUrl}
                class="font-mono text-xs text-muted no-underline hover:text-normal-lighter"
                target="_blank"
                rel="noopener noreferrer"
            >
                {buildMeta.label}
            </a>
        </footer>
    </body>
</html>
