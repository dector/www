---
import { G } from "../lib/globals.js";
import HtmlLayout from "./HtmlLayout.astro";

interface PostChange {
    hash: string;
    message: string;
    displayDate: string;
}

interface PostHistory {
    createdAt: string;
    updatedAt: string;
    currentVersion: string;
    changes: PostChange[];
}

interface Props {
    title: string;
    heading: string;
    date: string;
    revision?: string;
    history?: PostHistory | null;
}

const { title, heading, date, revision, history } = Astro.props;
const commitUrlTemplate = G.CommitUrlTemplate ?? "";
const getCommitUrl = (hash: string) =>
    commitUrlTemplate.replace("{{COMMIT}}", encodeURIComponent(hash));
---

<HtmlLayout title={title} sectionTitle="Notes" sectionHref="/notes">
    <main
        class="mx-auto flex max-w-4xl flex-col gap-4 px-3 py-12 text-lg lg:px-0"
    >
        <section class="flex flex-col gap-4">
            <h1 class="text-3xl font-thin text-normal">{heading}</h1>
            <div class="text-normal/75 font-light">
                {date}
                {
                    history ? (
                        <details class="inline">
                            <summary class="ml-2 inline cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                                (<span class="underline decoration-dotted underline-offset-4">ver {revision ?? history.currentVersion}</span>)
                            </summary>
                            <section class="mt-3 rounded-sm bg-muted/25 p-3 font-mono text-sm text-normal-lighter2">
                                <div>Created: {history.createdAt}</div>
                                <div>Updated: {history.updatedAt}</div>
                                <div>Current version: {revision ?? history.currentVersion}</div>
                                <div class="mt-2">Changes:</div>
                                <ul class="list-none ps-0">
                                    {history.changes.map((change) => (
                                        <li>
                                            <a
                                                href={getCommitUrl(change.hash)}
                                                class="block no-underline hover:underline hover:decoration-dotted hover:underline-offset-3 hover:text-normal-lighter3"
                                                target="_blank"
                                                rel="noreferrer"
                                            >
                                                {change.hash.slice(0, 8)} - {change.message} ({change.displayDate})
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </section>
                        </details>
                    ) : (
                        revision && (
                            <span class="ml-2">(<span class="underline decoration-dotted underline-offset-4">ver {revision}</span>)</span>
                        )
                    )
                }
            </div>
            <slot name="meta" />
            <article
                class="mt-8 flex flex-col gap-4 [&_a]:text-normal-lighter [&_a]:underline [&_a]:decoration-1 [&_a]:underline-offset-[5px] [&_a:hover]:text-normal-lighter2 [&_a:hover]:decoration-link3 [&_a:hover]:decoration-2 [&_a:hover]:underline-offset-[6px] [&_iframe]:block [&_iframe]:mx-auto [&_iframe]:max-w-full [&_code]:font-mono [&_code]:text-sm [&_code:not(pre_code)]:bg-muted [&_code:not(pre_code)]:px-1 [&_code:not(pre_code)]:text-normal-lighter3 [&_div:not(.code-block)]:flex [&_div:not(.code-block)]:flex-col [&_div:not(.code-block)]:gap-4 [&_li_p]:inline [&_.code-block]:relative [&_.code-block_.lang-tag]:pointer-events-none [&_.code-block_.lang-tag]:absolute [&_.code-block_.lang-tag]:right-0 [&_.code-block_.lang-tag]:top-0 [&_.code-block_.lang-tag]:inline [&_.code-block_.lang-tag]:p-2 [&_.code-block_.lang-tag]:text-sm [&_.code-block_.lang-tag]:uppercase [&_.code-block_.lang-tag]:text-muted [&_pre]:m-0 [&_pre]:overflow-x-auto [&_pre]:p-0 [&_pre]:text-[0.92rem] [&_pre_code.hljs]:block [&_pre_code.hljs]:overflow-x-auto [&_pre_code.hljs]:bg-[#282b2e] [&_pre_code.hljs]:px-4 [&_pre_code.hljs]:py-4 [&_pre_code.hljs]:leading-6 [&_pre_code.hljs]:text-[#e0e2e4] [&_.hljs-keyword]:text-[#93c763] [&_.hljs-literal]:text-[#93c763] [&_.hljs-selector-id]:text-[#93c763] [&_.hljs-selector-tag]:text-[#93c763] [&_.hljs-number]:text-[#ffcd22] [&_.hljs-attribute]:text-[#668bb0] [&_.hljs-link]:text-[#d39745] [&_.hljs-regexp]:text-[#d39745] [&_.hljs-meta]:text-[#557182] [&_.hljs-addition]:text-[#8cbbad] [&_.hljs-built_in]:text-[#8cbbad] [&_.hljs-bullet]:text-[#8cbbad] [&_.hljs-emphasis]:text-[#8cbbad] [&_.hljs-name]:text-[#8cbbad] [&_.hljs-selector-attr]:text-[#8cbbad] [&_.hljs-selector-pseudo]:text-[#8cbbad] [&_.hljs-subst]:text-[#8cbbad] [&_.hljs-tag]:text-[#8cbbad] [&_.hljs-template-tag]:text-[#8cbbad] [&_.hljs-template-variable]:text-[#8cbbad] [&_.hljs-type]:text-[#8cbbad] [&_.hljs-variable]:text-[#8cbbad] [&_.hljs-string]:text-[#ec7600] [&_.hljs-symbol]:text-[#ec7600] [&_.hljs-comment]:text-[#818e96] [&_.hljs-deletion]:text-[#818e96] [&_.hljs-quote]:text-[#818e96] [&_.hljs-selector-class]:text-[#a082bd] [&_.hljs-class_.hljs-title]:text-white [&_.hljs-code]:text-white [&_.hljs-section]:text-white [&_.hljs-doctag]:font-bold [&_.hljs-keyword]:font-bold [&_.hljs-literal]:font-bold [&_.hljs-name]:font-bold [&_.hljs-section]:font-bold [&_.hljs-selector-tag]:font-bold [&_.hljs-strong]:font-bold [&_.hljs-title]:font-bold [&_.hljs-type]:font-bold [&_ul]:list-inside [&_ul]:list-disc [&_ul]:ps-4"
            >
                <slot />
            </article>
            <div class="mt-4">
                <a
                    class="text-link3 opacity-70 no-underline hover:bg-link3 hover:px-2 hover:text-background hover:opacity-100"
                    href="/notes"
                >
                    &LeftArrow; Back to notes
                </a>
            </div>
        </section>
    </main>
</HtmlLayout>
