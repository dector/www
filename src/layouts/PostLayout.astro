---
import HtmlLayout from "./HtmlLayout.astro";
import PostContent from "../components/post/PostContent.astro";
import PostHeader from "../components/post/PostHeader.astro";

interface PostChange {
    hash: string;
    message: string;
    displayDate: string;
}

interface PostHistory {
    createdAt: string;
    updatedAt: string;
    currentVersion: string;
    changes: PostChange[];
}

interface Props {
    title: string;
    description?: string;
    canonical?: string;
    socialImage?: string;
    heading: string;
    date: string;
    publishedTime?: string;
    modifiedTime?: string | null;
    articleTags?: string[];
    revision?: string;
    history?: PostHistory | null;
}

const {
    title,
    description,
    canonical,
    socialImage,
    heading,
    date,
    publishedTime,
    modifiedTime,
    articleTags = [],
    revision,
    history,
} = Astro.props;
---

<HtmlLayout
    title={title}
    description={description}
    canonical={canonical}
    socialImage={socialImage}
    sectionTitle="Notes"
    sectionHref="/notes"
    ogType="article"
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    articleTags={articleTags}
>
    <main
        class="mx-auto flex max-w-4xl flex-col gap-4 px-3 py-12 text-lg lg:px-0"
    >
        <section class="flex flex-col gap-4">
            <PostHeader
                heading={heading}
                date={date}
                revision={revision}
                history={history}
            >
                <Fragment slot="meta">
                    <slot name="meta" />
                </Fragment>
            </PostHeader>

            <PostContent>
                <slot />
            </PostContent>

            <div class="mt-4">
                <a
                    class="text-link3 opacity-70 no-underline hover:bg-link3 hover:px-2 hover:text-background hover:opacity-100"
                    href="/notes"
                >
                    &LeftArrow; Back to notes
                </a>
            </div>
        </section>
    </main>
</HtmlLayout>
