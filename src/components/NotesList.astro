---
import Pin from "./icons/Pin.astro";

interface PostListItem {
    slug: string;
    title: string;
    pinned?: number;
}

interface Props {
    posts: PostListItem[];
}

const { posts } = Astro.props;
const pinnedPosts = posts.filter((post) => (post.pinned ?? -1) >= 0);
const regularPosts = posts.filter((post) => (post.pinned ?? -1) < 0);
---

<article class="flex flex-col gap-4">
    {
        pinnedPosts.length > 0 && (
            <ul class="mb-3 list-none p-0">
                {
                    pinnedPosts.map((post) => (
                        <li>
                            <a
                                class="group text-link3 hover:bg-link3 hover:px-2 hover:text-background"
                                href={`/notes/${post.slug}`}
                            >
                                <span
                                    class="mr-2 inline-flex align-middle text-normal/60 group-hover:text-background/80"
                                    title="Pinned note"
                                    aria-label="Pinned note"
                                >
                                    <Pin />
                                </span>
                                {post.title}
                            </a>
                        </li>
                    ))
                }
            </ul>
        )
    }

    <ul class="list-none p-0">
        {
            regularPosts.map((post) => (
                <li>
                    <a
                        class="text-link3 hover:bg-link3 hover:px-2 hover:text-background"
                        href={`/notes/${post.slug}`}
                    >
                        {post.title}
                    </a>
                </li>
            ))
        }
    </ul>
</article>
