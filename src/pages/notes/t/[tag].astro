---
import NotesList from "../../../components/NotesList.astro";
import HtmlLayout from "../../../layouts/HtmlLayout.astro";
import { G } from "../../../lib/globals.js";
import { getPublicNotesTagPages } from "../../../lib/notes.js";

interface TagPagePost {
    slug: string;
    title: string;
    pinned: number;
}

interface Props {
    tag: string;
    posts: TagPagePost[];
}

export async function getStaticPaths() {
    const tagPages = await getPublicNotesTagPages();

    return tagPages.map(({ tag, posts }) => ({
        params: { tag },
        props: { tag, posts },
    }));
}

const { tag, posts } = Astro.props as Props;
---

<HtmlLayout title={`Notes tagged ${tag} ~ ${G.BlogTitle}`} sectionTitle="Notes" sectionHref="/notes">
    <main
        class="mx-auto flex max-w-4xl flex-col gap-4 px-3 py-12 text-lg lg:px-0"
    >
        <section class="flex flex-col gap-4">
            <h1 class="text-3xl font-thin text-normal">
                Tag:
                <span class="font-mono">
                    {tag}
                </span>
            </h1>
            <NotesList posts={posts} />
        </section>
    </main>
</HtmlLayout>
