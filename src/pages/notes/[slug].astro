---
import PostLayout from "../../layouts/PostLayout.astro";
import { G } from "../../lib/globals.js";
import { getPostTagsWithPhantoms, getPublicNotesPosts } from "../../lib/notes.js";

export async function getStaticPaths() {
    const posts = await getPublicNotesPosts();
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const displayTags = getPostTagsWithPhantoms(post.tags);

const plainText = post.html.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
const seoDescription =
    plainText.length > 180
        ? `${plainText.slice(0, 179).trimEnd()}…`
        : plainText;
---

<PostLayout
    title={`${post.title} ~ ${G.BlogTitle}`}
    description={seoDescription}
    canonical={`/notes/${post.slug}/`}
    heading={post.title}
    date={post.displayDate}
    publishedTime={post.createdAt}
    modifiedTime={post.updatedAt}
    articleTags={displayTags}
    revision={post.revision}
    history={post.history}
>
    <div slot="meta">
        Tags:
        <span class="inline-flex flex-wrap gap-2">
            {
                displayTags.map((tag) => (
                    <a
                        href={`/notes/t/${tag}/`}
                        class="rounded-[1px] bg-link3 px-0.5 py-0 text-sm text-background opacity-50 no-underline hover:opacity-90"
                    >
                        {tag}
                    </a>
                ))
            }
        </span>
    </div>
    <div set:html={post.html} />
</PostLayout>
