---
import TagBadge from "../../components/ui/TagBadge.astro";
import PostLayout from "../../layouts/PostLayout.astro";
import { G } from "../../lib/globals.ts";
import { getPostTagsWithPhantoms, getPublicNotesPosts } from "../../lib/notes.ts";

export async function getStaticPaths() {
    const posts = await getPublicNotesPosts();
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const displayTags = getPostTagsWithPhantoms(post.tags);

const plainText = post.html.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
const seoDescription =
    plainText.length > 180
        ? `${plainText.slice(0, 179).trimEnd()}…`
        : plainText;
---

<PostLayout
    title={`${post.title} ~ ${G.BlogTitle}`}
    description={seoDescription}
    canonical={`/notes/${post.slug}/`}
    heading={post.title}
    date={post.displayDate}
    publishedTime={post.createdAt}
    modifiedTime={post.updatedAt}
    articleTags={displayTags}
    revision={post.revision != null ? String(post.revision) : undefined}
    history={post.history}
>
    <div slot="meta" class="flex flex-wrap items-center gap-2 text-sm text-normal-lighter">
        <span class="font-mono">tags:</span>
        <span class="inline-flex flex-wrap gap-2">
            {displayTags.map((tag) => <TagBadge tag={tag} />)}
        </span>
    </div>
    <div class="space-y-4" set:html={post.html} />
</PostLayout>
