---
import NotesList from "../../components/NotesList.astro";
import TagBadge from "../../components/ui/TagBadge.astro";
import HtmlLayout from "../../layouts/HtmlLayout.astro";
import { G } from "../../lib/globals.ts";
import { getPublicNotesPosts, getPublicNotesTagPages } from "../../lib/notes.ts";

const posts = await getPublicNotesPosts();
const tags = (await getPublicNotesTagPages()).map(({ tag }) => tag);
const pageTitle = `Notes ~ ${G.BlogTitle}`;
const pageDescription = `${G.BlogDescription}. Notes archive.`;
---

<HtmlLayout
    title={pageTitle}
    description={pageDescription}
    canonical="/notes/"
    sectionTitle="Notes"
    sectionHref="/notes"
>
    <main
        class="mx-auto flex max-w-4xl flex-col gap-4 px-3 py-12 text-lg lg:px-0"
    >
        <NotesList posts={posts} />

        {
            tags.length > 0 && (
                <section class="mt-10 flex flex-col gap-3 py-4">
                    <h2 class="font-mono text-sm tracking-wide text-normal-lighter2">
                        explore by tags
                    </h2>
                    <div class="flex flex-wrap gap-2">
                        {tags.map((tag) => <TagBadge tag={tag} />)}
                    </div>
                </section>
            )
        }
    </main>
</HtmlLayout>
