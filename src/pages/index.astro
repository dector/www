---
import HtmlLayout from "../layouts/HtmlLayout.astro";
import { G } from "../lib/globals.ts";

const pageTitle = G.BlogTitle;
const pageDescription = G.BlogDescription;
---

<HtmlLayout
    title={pageTitle}
    description={pageDescription}
    canonical="/"
    sectionTitle=""
>
    <main class="mx-auto flex max-w-4xl px-3 py-12 lg:px-0">
        <section class="relative flex w-full flex-col items-start text-left">
            <a
                class="home-link inline-flex items-center font-mono text-4xl font-light text-link3 hover:bg-link3 hover:px-2 hover:text-background focus-visible:outline-2 focus-visible:outline-offset-6 focus-visible:outline-link3 md:text-5xl"
                href="/notes"
            >
                /Notes/
            </a>
        </section>
    </main>
</HtmlLayout>

<style>
    .home-link {
        letter-spacing: 0.015em;
    }
</style>
