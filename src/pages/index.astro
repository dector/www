---
import HomeLink from "../components/HomeLink.astro";
import HtmlLayout from "../layouts/HtmlLayout.astro";
import { G } from "../lib/globals.ts";

const pageTitle = G.BlogTitle;
const pageDescription = G.BlogDescription;
---

<HtmlLayout
    title={pageTitle}
    description={pageDescription}
    canonical="/"
    sectionTitle=""
>
    <main class="mx-auto flex max-w-4xl px-3 py-12 lg:px-0">
        <section class="relative flex w-full flex-col items-start gap-3 text-left">
            <HomeLink href="/notes" label="/Notes" color="link3" />
            <HomeLink href="/projects" label="/Projects" color="link2" />
        </section>
    </main>
</HtmlLayout>

