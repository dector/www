---
import type { GetStaticPaths } from "astro";
import GoLibraryPage from "../../../components/GoLibraryPage.astro";
import { goLibraries } from "../../../lib/go-libraries.ts";

export const getStaticPaths = (() =>
    goLibraries.map((library) => ({
        params: { library: library.name },
        props: { library },
    }))) satisfies GetStaticPaths;

const { library } = Astro.props;
---
<GoLibraryPage
    name={library.name}
    description={library.description}
    importPath={`dector.space/go/${library.name}`}
    repoUrl={`https://github.com/dector/${library.name}`}
/>
