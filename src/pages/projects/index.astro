---
import HtmlLayout from "../../layouts/HtmlLayout.astro";
import GitHub from "../../components/icons/GitHub.astro";
import Globe from "../../components/icons/Globe.astro";
import Pin from "../../components/icons/Pin.astro";
import { G } from "../../lib/globals.ts";
import githubData from "../../lib/github_data.json";

type Project = {
    name: string;
    summary: string;
    tags: string[];
    status: "Active" | "Stale" | "Archived";
    repoUrl: string;
    homepageUrl: string | null;
    updatedAt: string;
    isPinned: boolean;
};

const pageTitle = `Projects ~ ${G.BlogTitle}`;
const pageDescription = "Public repositories from github.com/dector.";

const statusClass: Record<Project["status"], string> = {
    Active: "border-link2 text-link2",
    Stale: "border-link1 text-link1",
    Archived: "border-link3 text-link3",
};

const projects = githubData.projects as Project[];
---

<HtmlLayout
    title={pageTitle}
    description={pageDescription}
    canonical="/projects/"
    sectionTitle="Projects"
    sectionHref="/projects"
>
    <main class="mx-auto flex max-w-4xl flex-col gap-6 px-3 py-12 lg:px-0">
        <section class="grid grid-cols-1 gap-4 md:grid-cols-2">
            {
                projects.map((project) => (
                    <article class="flex h-full flex-col rounded border border-muted/60 bg-black/10 p-4">
                        <div class="mb-2 flex items-start justify-between gap-3">
                            <h2 class="font-mono text-xl font-light text-normal-lighter3">
                                {project.name}
                            </h2>
                            <div class="inline-flex items-center gap-1">
                                {project.isPinned && project.status === "Active" && <Pin />}
                                <span
                                    class:list={[
                                        "rounded border px-2 py-0.5 font-mono text-xs",
                                        statusClass[project.status],
                                    ]}
                                >
                                    {project.status}
                                </span>
                            </div>
                        </div>

                        <p class="mb-4 flex-1 text-sm text-normal-lighter2">
                            {project.summary}
                        </p>

                        <div class="mb-4 flex flex-wrap gap-2">
                            {project.tags.map((tag) => (
                                <span class="rounded bg-muted/25 px-2 py-0.5 font-mono text-xs text-normal-lighter2">
                                    {tag}
                                </span>
                            ))}
                        </div>

                        <p class="mb-3 font-mono text-xs text-normal-lighter2">
                            updated{" "}
                            {new Date(project.updatedAt).toLocaleDateString("en-GB", {
                                year: "numeric",
                                month: "short",
                                day: "numeric",
                            })}
                        </p>

                        <div class="flex flex-wrap items-center gap-3">
                            <a
                                href={project.repoUrl}
                                class="inline-flex items-center gap-1 font-mono text-sm text-link3 no-underline hover:text-link3-darker"
                            >
                                <GitHub />
                                GitHub
                            </a>
                            {
                                project.homepageUrl && (
                                    <a
                                        href={project.homepageUrl}
                                        class="inline-flex items-center gap-1 font-mono text-sm text-link2 no-underline hover:text-link2-darker"
                                    >
                                        <Globe />
                                        Live
                                    </a>
                                )
                            }
                        </div>
                    </article>
                ))
            }
        </section>
    </main>
</HtmlLayout>
