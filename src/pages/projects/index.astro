---
import HtmlLayout from "../../layouts/HtmlLayout.astro";
import GitHub from "../../components/icons/GitHub.astro";
import Globe from "../../components/icons/Globe.astro";
import Pin from "../../components/icons/Pin.astro";
import { G } from "../../lib/globals.ts";

type GithubRepo = {
    name: string;
    description: string | null;
    html_url: string;
    homepage: string | null;
    topics?: string[];
    language: string | null;
    archived: boolean;
    updated_at: string;
};

type Project = {
    name: string;
    summary: string;
    tags: string[];
    status: "Active" | "Stale" | "Archived";
    repoUrl: string;
    homepageUrl: string | null;
    updatedAt: string;
};

const PINNED_REPO = "www";

const INCLUDED_REPOS = new Set([
    "www",
    "config-astronvim",
    "dotfiles",
    "pi-x",
    "serv",
    "kdly",
    "paper-toolkit",
    "awesome-organic-writing",
    "hata",
    "lampa",
    "respect-busy-maintainers",
    "authie",
    "homelab-public",
    "bang",
    "engbook",
    "run-lampa",
    "tg-bumblebee-bot",
    "moon_lander",
    "pustomario",
    "sarif-kotlin",
    "light-map",
    "pipes.kt",
    "processing-fun",
    "uCompiler",
    "space-lander",
    "ludum-dare",
    "CleverBlocks",
    "scatris",
    "Stackoverflow-answers",
    "quotes-clean",
    "kotris",
    "rkpi",
    "ld29",
    "ld29-haxe",
    "snake",
    "personal-notes",
    "tlamp",
    "lh2l_project",
    "social-interaction",
    "im-sorry-dave",
    "plchdr-kt",
    "tuya-lib",
    "ghosty",
    "quotes",
    "things",
    "dector",
    "dead-art-space",
    "exercism-kotlin",
    "tkgbot",
    "kotlin-guides",
]);

const STALE_AFTER_DAYS = 365;

function getProjectStatus(repo: GithubRepo): Project["status"] {
    if (repo.archived) return "Archived";

    const updatedAt = new Date(repo.updated_at).getTime();
    const staleThreshold = Date.now() - STALE_AFTER_DAYS * 24 * 60 * 60 * 1000;

    return updatedAt < staleThreshold ? "Stale" : "Active";
}

async function fetchAllPublicRepos(username: string): Promise<Project[]> {
    const allRepos: GithubRepo[] = [];
    let page = 1;

    while (true) {
        const response = await fetch(
            `https://api.github.com/users/${username}/repos?per_page=100&page=${page}&type=public&sort=updated`,
            {
                headers: {
                    Accept: "application/vnd.github+json",
                    "User-Agent": "dector-www-projects-page",
                },
            },
        );

        if (!response.ok) {
            throw new Error(`GitHub API responded with ${response.status}`);
        }

        const repos = (await response.json()) as GithubRepo[];
        if (repos.length === 0) break;

        allRepos.push(...repos);

        if (repos.length < 100) break;
        page += 1;
    }

    return allRepos
        .filter((repo) => INCLUDED_REPOS.has(repo.name))
        .sort((a, b) => {
            if (a.name === PINNED_REPO && b.name !== PINNED_REPO) return -1;
            if (b.name === PINNED_REPO && a.name !== PINNED_REPO) return 1;

            return new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime();
        })
        .map((repo) => {
            const tags = repo.topics?.length
                ? repo.topics
                : repo.language
                  ? [repo.language]
                  : ["misc"];

            return {
                name: repo.name,
                summary: repo.description ?? "No description provided.",
                tags,
                status: getProjectStatus(repo),
                repoUrl: repo.html_url,
                homepageUrl: repo.homepage,
                updatedAt: repo.updated_at,
            };
        });
}

const pageTitle = `Projects ~ ${G.BlogTitle}`;
const pageDescription = "Public repositories from github.com/dector.";

const statusClass: Record<Project["status"], string> = {
    Active: "border-link2 text-link2",
    Stale: "border-link1 text-link1",
    Archived: "border-link3 text-link3",
};

let projects: Project[] = [];
let fetchError: string | null = null;

try {
    projects = await fetchAllPublicRepos("dector");
} catch (error) {
    console.error("Failed to fetch public repositories", error);
    fetchError = "Could not load repositories from GitHub right now.";
}
---

<HtmlLayout
    title={pageTitle}
    description={pageDescription}
    canonical="/projects/"
    sectionTitle="Projects"
    sectionHref="/projects"
>
    <main class="mx-auto flex max-w-4xl flex-col gap-6 px-3 py-12 lg:px-0">
        <p class="max-w-2xl text-normal-lighter2">
            All public repositories from <a href="https://github.com/dector">github.com/dector</a>,
            shown as projects.
        </p>

        {
            fetchError && (
                <p class="rounded border border-link3/40 bg-link3/10 px-3 py-2 text-sm text-link3">
                    {fetchError}
                </p>
            )
        }

        <section class="grid grid-cols-1 gap-4 md:grid-cols-2">
            {
                projects.map((project) => (
                    <article class="flex h-full flex-col rounded border border-muted/60 bg-black/10 p-4">
                        <div class="mb-2 flex items-start justify-between gap-3">
                            <h2 class="font-mono text-xl font-light text-normal-lighter3">
                                {project.name}
                            </h2>
                            <div class="inline-flex items-center gap-1">
                                {project.name === PINNED_REPO && project.status === "Active" && <Pin />}
                                <span
                                    class:list={[
                                        "rounded border px-2 py-0.5 font-mono text-xs",
                                        statusClass[project.status],
                                    ]}
                                >
                                    {project.status}
                                </span>
                            </div>
                        </div>

                        <p class="mb-4 flex-1 text-sm text-normal-lighter2">
                            {project.summary}
                        </p>

                        <div class="mb-4 flex flex-wrap gap-2">
                            {project.tags.map((tag) => (
                                <span class="rounded bg-muted/25 px-2 py-0.5 font-mono text-xs text-normal-lighter2">
                                    {tag}
                                </span>
                            ))}
                        </div>

                        <p class="mb-3 font-mono text-xs text-normal-lighter2">
                            updated{" "}
                            {new Date(project.updatedAt).toLocaleDateString("en-GB", {
                                year: "numeric",
                                month: "short",
                                day: "numeric",
                            })}
                        </p>

                        <div class="flex flex-wrap items-center gap-3">
                            <a
                                href={project.repoUrl}
                                class="inline-flex items-center gap-1 font-mono text-sm text-link3 no-underline hover:text-link3-darker"
                            >
                                <GitHub />
                                GitHub
                            </a>
                            {
                                project.homepageUrl && (
                                    <a
                                        href={project.homepageUrl}
                                        class="inline-flex items-center gap-1 font-mono text-sm text-link2 no-underline hover:text-link2-darker"
                                    >
                                        <Globe />
                                        Live
                                    </a>
                                )
                            }
                        </div>
                    </article>
                ))
            }
        </section>
    </main>
</HtmlLayout>
